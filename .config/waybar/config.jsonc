{
  "layer": "top",
  "position": "top",
  // "magin-bottom": 10,
  "spacing": 18,
  "modules-center": [
    "clock"
  ],
  "modules-left": [
    "custom/notification",
    "hyprland/workspaces"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery"
  ],
  "clock": {
    "format": "{:L%H:%M}",
    "format-alt": "{:L%Y年 %m月 %d日}",
    "tooltip-format": "<span font='WenQuanYi Zen Hei Mono 12'><big>{:%Y年 %B}</big>\n<tt><small>{calendar}</small></tt></span>",
    "locale": "zh_CN.UTF-8",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "days": "<span color='#d4deb2'><b>{}</b></span>",
        "weeks": "<span color='#98a75a'><b>第{}周</b></span>",
        "weekdays": "<span color='#69bf9b'><b>  日   一   二    三    四   五    六 </b></span>",
        "today": "<span color='#bd2828'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click": "mode"
    }
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5 // 5 workspaces by default on every monitor
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% ",
    "format-muted": "muted 󰖁",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "",
      "headset": "󰋍",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "",
        "󰕾"
      ]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": [
      "Easy Effects Sink"
    ]
  },
  "network": {
    // "interface": "wlan0",
    // "format": "{ifname}",
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": "󰊗",
    "format-disconnected": "",
    // "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    // "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected"
    // "max-length": 1
  },
  "battery": {
    "format": "{capacity}"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "",
    "on-click": "swaync-client -t -sw",
    "escape": true
  }
}
