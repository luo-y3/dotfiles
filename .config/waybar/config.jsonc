{
  "layer": "top",
  "position": "top",
  // "magin-bottom": 10,
  "spacing": 4,
  "modules-center": ["custom/calendar"],
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-right": [
    "cava",
    "pulseaudio",
    "custom/notification",
    "custom/fcitx",
    "network",
    "battery",
  ],

  // -------------------Center-------------------
  "custom/calendar": {
    "format": "{}",
    "interval": 1,
    "exec": "date '+%H:%M'",
    "on-click": "kitty --title lvsk-calendar -e lvsk-calendar-launcher",
    "tooltip": false,
  },

  //  --------------------Left-------------------
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      // "active": "",
      // "default": "k"
    },
    "persistent-workspaces": {
      "*": 5, // 5 workspaces by default on every monitor
    },
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "tray": {
    "icon-size": 20,
    "spacing": 8,
  },
  // --------------------Right-------------------
  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Brave": "󰈹 $1",
      "(.*) - kitty": "  $1",
      "(.*) - Dolphin": "󰉋 $1",
      "": "",
    },
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% ",
    "format-muted": "muted 󰖁",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "",
      "headset": "󰋍",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "", "󰕾"],
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
  },
  "cava": {
    // "cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
    "framerate": 30,
    "autosens": 0,
    "sensitivity": 0.1,
    "bars": 14,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "hide_on_silence": false,
    // "format_silent": "quiet",
    "method": "pulse",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.27,
    "input_delay": 2,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "actions": {
      "on-click-right": "mode",
    },
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "󰝦  Disconnected",
    "tooltip-format-wifi": "  {essid} ({signalPercent}%)",
    "tooltip-format-ethernet": "󰈀  {ifname}",
    "on-click": "~/.config/waybar/scripts/rofi-network-manager.sh",
  },

  "custom/fcitx": {
    "exec": "~/.config/waybar/scripts/fcitx-status.sh",
    "restart-interval": 0,
  },

  "battery": {
    "format": "{capacity}",
  },
}
